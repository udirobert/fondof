#!/bin/sh

# --- Secret scanning ---
# Check staged files for potential secrets
SECRETS_PATTERN='(PRIVATE_KEY|SECRET|PASSWORD|TOKEN|API_KEY)\s*=\s*["\x27]?[A-Za-z0-9+/=_-]{20,}'
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -n "$STAGED_FILES" ]; then
  # Check for hardcoded secrets (skip .example, .md, and .husky files)
  SCAN_FILES=$(echo "$STAGED_FILES" | grep -v '\.example$' | grep -v '\.md$' | grep -v '^\.husky/' || true)
  if [ -n "$SCAN_FILES" ]; then
    MATCHES=$(echo "$SCAN_FILES" | xargs grep -lEn "$SECRETS_PATTERN" 2>/dev/null || true)
    if [ -n "$MATCHES" ]; then
      echo "ERROR: Potential secrets detected in staged files:"
      echo "$MATCHES"
      echo ""
      echo "If these are intentional (e.g. test values), use git commit --no-verify"
      exit 1
    fi

    # Check for private keys (skip hook scripts)
    KEY_FILES=$(echo "$SCAN_FILES" | xargs grep -l 'BEGIN.*PRIVATE KEY' 2>/dev/null || true)
    if [ -n "$KEY_FILES" ]; then
      echo "ERROR: Private key detected in staged files:"
      echo "$KEY_FILES"
      exit 1
    fi
  fi

  # Check for .env files being committed
  ENV_FILES=$(echo "$STAGED_FILES" | grep -E '^\.env$|^\.env\.' | grep -v '\.example$' || true)
  if [ -n "$ENV_FILES" ]; then
    echo "ERROR: .env file(s) staged for commit:"
    echo "$ENV_FILES"
    echo ""
    echo "These likely contain secrets. Add them to .gitignore."
    exit 1
  fi
fi

# --- Lint staged files ---
npx lint-staged
