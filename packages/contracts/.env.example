# Monad RPC endpoints
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz

# Deployer private key (same as relayer for Blitz)
DEPLOYER_PRIVATE_KEY=0x...

# Resolver address (for challenge resolution — set to relayer address for Blitz)
RESOLVER_ADDRESS=0x...

# Block explorer
MONAD_EXPLORER_URL=https://testnet.monadexplorer.com/api
EXPLORER_API_KEY=
