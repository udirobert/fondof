# Copy to .env for local tooling. Worker secrets: `cd packages/api && wrangler secret put …`
# Never commit real keys.

# --- Monad / SkillPool ---
MONAD_RPC_URL=https://monad-testnet.g.alchemy.com/v2/YOUR_KEY
FONDOF_CONTRACT_ADDRESS=0x75545e2C450897914df416d0D24aeB33a89a8b19
FONDOF_RELAYER_KEY=0xYOUR_RELAYER_PRIVATE_KEY

# --- Web (packages/web) ---
NEXT_PUBLIC_API_URL=https://fondof-api.trustfall.workers.dev
NEXT_PUBLIC_FONDOF_CONTRACT_ADDRESS=0x75545e2C450897914df416d0D24aeB33a89a8b19
# NEXT_PUBLIC_SITE_URL=https://fondof.netlify.app

# --- Auth (GitHub OAuth) ---
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
STRIPE_PRICE_ID=price_your_pro_plan_price_id

